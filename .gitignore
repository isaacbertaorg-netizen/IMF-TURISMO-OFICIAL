# ===========================================================================
# IMF TURISMO — .gitignore da NUVEM (versionado)
# Regras gerais do projeto para o repositório compartilhado.
# Regras pessoais/locais (ex.: .opencode/, docs/) ficam no .gitignore.local,
# que NUNCA é versionado.
# ===========================================================================

# ---------------------------------------------------------------------------
# Variáveis de ambiente e segredos
# .env contém chaves reais e NUNCA é versionado. Apenas .env.example (sem
# valores reais) deve estar no repositório.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python (back-end — server/)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node (front-end — client/)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Sistemas operacionais e editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Arquivo de regras locais do desenvolvedor — nunca versionar
# ---------------------------------------------------------------------------
.gitignore.local

.vercel
.env*
