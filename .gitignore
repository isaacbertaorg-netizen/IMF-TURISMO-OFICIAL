# ===========================================================================
# IMF TURISMO — .gitignore do PROJETO (versionado)
# Regras gerais do projeto para o repositório compartilhado.
#
# Regras pessoais desta máquina NÃO ficam aqui: use .git/info/exclude,
# que é lido pelo Git, vive dentro de .git/ e nunca é versionado.
# Atenção: um arquivo chamado .gitignore.local NÃO é lido pelo Git.
# ===========================================================================

# ---------------------------------------------------------------------------
# Variáveis de ambiente e segredos
# .env contém chaves reais e NUNCA é versionado. Apenas .env.example (sem
# valores reais) deve estar no repositório.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python (back-end — server/)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Node (front-end — client/)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Sistemas operacionais e editores
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Arquivo de regras locais antigo.
# ATENÇÃO: o Git não lê este arquivo. O mecanismo correto por repositório é
# .git/info/exclude (ver cabeçalho). A linha abaixo só evita que um arquivo
# remanescente apareça como não rastreado.
# ---------------------------------------------------------------------------
.gitignore.local

# ---------------------------------------------------------------------------
# Vercel (vínculo local do projeto — nunca versionar)
# ---------------------------------------------------------------------------
.vercel/
