# ===========================================================================
# IMF TURISMO — variáveis de ambiente (MODELO)
# Copie este arquivo para `.env` e preencha com os valores reais.
# NUNCA versione o `.env` (ver seção 6.3 do PRODUCT.md).
#
# O front-end (client/) não acessa o Supabase diretamente: consome apenas a
# API (server/). Por isso todas as chaves do Supabase vivem no back-end.
# ===========================================================================

# ------------------------- Supabase (comum) ---------------------------------
# URL do projeto Supabase, ex.: https://xxxxxxxx.supabase.co
# Informe apenas a base, sem barra final: o client adiciona /rest/v1 sozinho.
SUPABASE_URL=

# Chave pública do Supabase — pode ser exposta ao front-end.
# Aceita a legada (anon, formato JWT) ou a nova (sb_publishable_...).
SUPABASE_ANON_KEY=

# Chave secreta do Supabase — SOMENTE no back-end. NUNCA no front-end.
# Aceita a legada (service_role, formato JWT) ou a nova (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------- JWT de sessão (server/) ---------------------------
# O schema usa senha_hash em cliente/administrador; a API emite JWT próprio.
# Se não definido, usa SUPABASE_SERVICE_ROLE_KEY como secret. Recomendado
# definir um JWT_SECRET específico e longo em produção.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------- Back-end (server/) --------------------------------
# Host e porta do servidor FastAPI/uvicorn.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Dominio de origem permitido pelo CORS (domínio oficial do front-end).
# Em desenvolvimento use http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ------------------------- Rate limiting (seção 6.5 do PRODUCT.md) ------------
# Limites por minuto das rotas públicas sensíveis.
# Use RATE_LIMIT_ENABLED=false para desativar em desenvolvimento/testes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CADASTRO=5/minute
RATE_LIMIT_RESERVAS=20/minute

# ------------------------- Front-end (client/) -------------------------------
# URL base da API do back-end usada pelo axios.
# Local: http://localhost:8000. No Vercel (back junto), omita a variável —
# o front usa a mesma origem (/api) automaticamente.
VITE_API_BASE_URL=http://localhost:8000
